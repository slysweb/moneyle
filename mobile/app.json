{
  "expo": {
    "name": "Moneyle",
    "slug": "moneygames",
    "scheme": "moneygames",
    "version": "1.0.3",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#0fad6e",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1ecc8f"
    },
    "ios": {
      "bundleIdentifier": "cc.moneygames.app",
      "supportsTablet": false
    },
    "android": {
      "package": "cc.moneygames.app",
      "adaptiveIcon": {
        "backgroundColor": "#1ecc8f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "moneygames"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1ecc8f",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f4bf6b3-ca80-49fd-a3ce-3505ca84d750"
      }
    },
    "owner": "liushaoping"
  }
}
