{
  "name": "moneygames",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MoneyGames — free browser games about money: More/Less, Money Guessr, and Moneyle.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "check": "tsc -b && vite build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy",
    "data:forbes": "node scripts/process-forbes.mjs",
    "data:gdp": "node scripts/fetch-gdp.mjs",
    "data:athletes": "node scripts/build-athletes.mjs",
    "data:box-office": "node scripts/process-box-office.mjs",
    "data:market-cap": "node scripts/process-market-cap.mjs",
    "data:movie-posters": "node scripts/fetch-movie-posters.mjs",
    "data:athlete-images": "node scripts/fetch-athlete-images.mjs",
    "data:usd-money": "node scripts/fetch-usd-money.mjs",
    "data:usd-optimize": "python scripts/optimize-usd-images.py",
    "data:moreless-images": "node scripts/fetch-moreless-images.mjs",
    "data:all": "npm run data:forbes && npm run data:gdp && npm run data:athletes && npm run data:athlete-images && npm run data:box-office && npm run data:movie-posters && npm run data:market-cap && npm run data:moreless-images && npm run data:seed",
    "data:seed": "node scripts/build-seed.mjs",
    "db:schema:local": "wrangler d1 execute moneygames-db --local --file=db/schema.sql",
    "db:seed:local": "wrangler d1 execute moneygames-db --local --file=db/seed.sql",
    "db:schema:remote": "wrangler d1 execute moneygames-db --remote --file=db/schema.sql",
    "db:seed:remote": "wrangler d1 execute moneygames-db --remote --file=db/seed.sql",
    "db:guessr:local": "wrangler d1 execute moneygames-db --local --file=db/money.sql",
    "db:guessr:remote": "wrangler d1 execute moneygames-db --remote --file=db/money.sql",
    "db:money:local": "wrangler d1 execute moneygames-db --local --file=db/money.sql",
    "db:money:remote": "wrangler d1 execute moneygames-db --remote --file=db/money.sql",
    "db:feedback:local": "wrangler d1 execute moneygames-db --local --file=db/feedback.sql",
    "db:feedback:remote": "wrangler d1 execute moneygames-db --remote --file=db/feedback.sql",
    "data:money-seed": "node scripts/build-money-seed.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.2",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.120.1"
  }
}
