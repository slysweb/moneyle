{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.worker.tsbuildinfo"
  },
  "include": [
    "worker",
    "src/lib/articles.ts",
    "src/lib/articleHtml.ts",
    "src/lib/pageMeta.ts",
    "src/lib/sitemap.ts",
    "src/lib/gameHtml.ts",
    "src/lib/homeHtml.ts",
    "src/lib/contact.ts"
  ]
}
