{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moneygames",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  // Custom domain is attached after first deploy:
  //   wrangler deploy && add route in dashboard, or uncomment below.
  // "routes": [{ "pattern": "moneygames.cc", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moneygames-db",
      // Replace with the real ID from `wrangler d1 create moneygames-db`.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
