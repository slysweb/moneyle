{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "moneyle",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-01",
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		// Browser navigations (e.g. Continue with Google) send Sec-Fetch-Mode:
		// navigate. Without this, SPA fallback serves index.html instead of the Worker.
        "run_worker_first": [
			"/",
			"/api/*",
			"/articles",
			"/articles/*",
			"/moreless",
			"/guessr",
			"/banknotele",
			"/connections",
			"/sitemap.xml",
			"/sitemap.xml/",
			"/robots.txt"
		]
	},
	"observability": {
		"enabled": true
	},
	// America/Denver midnight: 07:00 UTC in MST, 06:00 UTC in MDT.
	"triggers": {
		"crons": [
			"0 6 * * *",
			"0 7 * * *"
		]
	},
	"routes": [
		{ "pattern": "moneyle.app", "custom_domain": true },
		{ "pattern": "www.moneyle.app", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "moneygames-db",
			// Replace with the real ID from `wrangler d1 create moneygames-db`.
			"database_id": "c956e4e8-8335-4bca-a75c-f7ddd2ec0834"
		},
		{
			"binding": "moneygames_db",
			"database_name": "moneygames-db",
			"database_id": "c956e4e8-8335-4bca-a75c-f7ddd2ec0834",
			"remote": true
		}
	]
}